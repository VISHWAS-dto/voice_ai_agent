# Keep the build context small and deterministic.

# Virtual environments — never ship the host's venv into the image.
myenv/
.venv/
venv/
env/
ENV/

# Local model cache: the image bakes its own copy at build time
# (MODEL_CACHE_SEED). Shipping the host's 1.2 GB cache would bloat the
# context for nothing.
.model_cache/
models/
*.pt
*.bin
*.onnx
*.safetensors

# VCS / CI
.git/
.gitignore

# Python bytecode / test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Env files
.env
.env.*

# Eval datasets / reports
eval/datasets/
eval/reports/
